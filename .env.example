ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Local service addresses
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=3100
CONTROLLER_URL=http://127.0.0.1:3100
CONTROLLER_INTERNAL_TOKEN=change-me-for-shared-environments
RESTATE_INGRESS_URL=http://127.0.0.1:8080
RESTATE_ADMIN_URL=http://127.0.0.1:9070
RESTATE_UI_URL=http://127.0.0.1:9070/ui
WORKER_HOST=127.0.0.1
WORKER_PORT=9080
WORKER_PUBLIC_URL=http://127.0.0.1:9080

# Demo timing
DEMO_TOOL_DELAY_MS=2200
WORKER_RESTART_DELAY_MS=1800
